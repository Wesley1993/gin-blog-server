# Z-blog 生产环境配置模板
# 复制为 config.yaml 并填入真实值，chmod 600
# 此文件放置在 /opt/zblog/config.yaml，通过 Docker volume 挂载到容器内

app:
  name: blog-admin
  version: 0.0.1
  mode: release
  port: 3000

database:
  driver: postgres
  host: postgres          # Docker Compose 服务名
  port: 5432
  user: appuser           # 与 .env POSTGRES_USER 一致
  password: CHANGE_ME     # 与 .env POSTGRES_PASSWORD 一致
  dbname: blog            # 与 .env POSTGRES_DB 一致
  max_idle_conns: 5       # 2C4G 环境下调小
  max_open_conns: 30      # 原 100 对 2C4G 过大
  conn_max_lifetime: 1800

redis:
  addr: redis:6379        # Docker Compose 服务名
  password: CHANGE_ME     # 与 .env REDIS_PASSWORD 一致
  db: 1
  pool_size: 10
  min_idle_conns: 2

jwt:
  secret: CHANGE_ME       # 必须替换！运行: openssl rand -hex 32
  expire: 24
  prefix: blog_

swagger:
  enabled: false          # 生产必须关闭！
  host: ""
  base_path: /api

log:
  level: info
  file_path: ""           # 日志走 stdout，由 Docker json-file driver 管理
  max_size: 100
  max_backups: 3

migration:
  dir: ./migrations       # 相对于 WORKDIR /app

elasticsearch:
  addresses: ["http://es:9200"]  # 一期不部署 ES，连不上会自动降级
  index_prefix: "blog"
  username: ""
  password: ""
